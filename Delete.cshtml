@model HelpDesk.Mvc.Models.TicketViewModel
@{
    ViewData["Title"] = "Delete Ticket #" + Model.Id;
}

<div class="row mb-4">
    <div class="col-12">
        <a asp-action="Index" class="text-muted text-decoration-none mb-3 d-inline-block">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Tickets List
        </a>
        <h2 class="fw-bold text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Delete Support Ticket #@Model.Id</h2>
        <p class="text-muted">Are you sure you want to permanently delete this ticket?</p>
    </div>
</div>

<div class="glass-panel p-4 col-md-8 mx-auto border-danger">
    <div class="alert alert-warning bg-warning text-dark border-0 mb-4">
        <i class="fa-solid fa-triangle-exclamation me-2"></i><strong>Warning:</strong> This action cannot be undone.
    </div>

    <div class="row mb-3">
        <div class="col-sm-3 text-muted fw-semibold">Title:</div>
        <div class="col-sm-9 text-white fw-bold">@Model.Title</div>
    </div>
    <div class="row mb-3">
        <div class="col-sm-3 text-muted fw-semibold">Raised By:</div>
        <div class="col-sm-9 text-white">@Model.RaisedBy</div>
    </div>
    <div class="row mb-3">
        <div class="col-sm-3 text-muted fw-semibold">Priority:</div>
        <div class="col-sm-9">@Model.Priority</div>
    </div>
    <div class="row mb-3">
        <div class="col-sm-3 text-muted fw-semibold">Status:</div>
        <div class="col-sm-9">@Model.Status</div>
    </div>
    <div class="row mb-4">
        <div class="col-sm-3 text-muted fw-semibold">Description:</div>
        <div class="col-sm-9 text-white bg-dark p-3 rounded border border-secondary">@Model.Description</div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
            <button type="submit" class="btn btn-danger btn-lg px-4">
                <i class="fa-solid fa-trash me-1"></i> Confirm Delete
            </button>
        </div>
    </form>
</div>

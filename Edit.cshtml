@model HelpDesk.Mvc.Models.TicketViewModel
@{
    ViewData["Title"] = "Edit Ticket #" + Model.Id;
}

<div class="row mb-4">
    <div class="col-12">
        <a asp-action="Index" class="text-muted text-decoration-none mb-3 d-inline-block">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Tickets List
        </a>
        <h2 class="fw-bold"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Edit Support Ticket #@Model.Id</h2>
        <p class="text-muted">Update ticket status, priority, or description details.</p>
    </div>
</div>

<div class="glass-panel p-4 col-md-8 mx-auto">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedDate" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-semibold">Title *</label>
            <input asp-for="Title" class="form-control" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RaisedBy" class="form-label fw-semibold">Raised By *</label>
            <input asp-for="RaisedBy" class="form-control" required />
            <span asp-validation-for="RaisedBy" class="text-danger"></span>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="Priority" class="form-label fw-semibold">Priority *</label>
                <select asp-for="Priority" class="form-select" required>
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                </select>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Status" class="form-label fw-semibold">Status *</label>
                <select asp-for="Status" class="form-select" required>
                    <option value="Open">Open</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Closed">Closed</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-semibold">Description *</label>
            <textarea asp-for="Description" class="form-control" rows="5" required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
            <button type="submit" class="btn btn-primary-custom">
                <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
